code = "shader_type canvas_item;
render_mode blend_add, unshaded;

uniform float Vsabilty : hint_range(0.0, 1.0);
uniform vec2 Speed;
uniform sampler2D Basic_texture : source_color, repeat_enable;



void fragment() {
// Input:11
	vec4 n_out11p0 = COLOR;


// FloatParameter:10
	float n_out10p0 = Vsabilty;


// Input:6
	float n_out6p0 = TIME;


// Vector2Parameter:8
	vec2 n_out8p0 = Speed;


// VectorOp:7
	vec2 n_out7p0 = vec2(n_out6p0) * n_out8p0;


// UVFunc:5
	vec2 n_in5p1 = vec2(1.00000, 1.00000);
	vec2 n_out5p0 = n_out7p0 * n_in5p1 + UV;


	vec4 n_out4p0;
// Texture2D:4
	n_out4p0 = texture(Basic_texture, n_out5p0);
	float n_out4p1 = n_out4p0.r;


// SmoothStep:9
	vec2 n_in9p1 = vec2(1.00000, 1.00000);
	vec2 n_out9p0 = smoothstep(vec2(n_out10p0), n_in9p1, vec2(n_out4p1));


// VectorOp:12
	vec2 n_out12p0 = vec2(n_out11p0.xy) * n_out9p0;


// Output:0
	COLOR.rgb = vec3(n_out12p0, 0.0);


}
"
